BCHOC_FILE_PATH_ENV = "BCHOC_FILE_PATH"
DEFAULT_BLOCKCHAIN_FILE = "bchoc.db"

PASSWORD_ENV_VARS = {
    "creator": "BCHOC_PASSWORD_CREATOR",
    "police": "BCHOC_PASSWORD_POLICE",
    "lawyer": "BCHOC_PASSWORD_LAWYER",
    "analyst": "BCHOC_PASSWORD_ANALYST",
    "executive": "BCHOC_PASSWORD_EXECUTIVE",
}
OWNER_ROLES = ["police", "lawyer", "analyst", "executive"]
REMOVAL_REASONS = ["DISPOSED", "DESTROYED", "RELEASED"]

def check_password(password, roles):
    for role in roles:
        env_var = PASSWORD_ENV_VARS.get(role)
        if env_var:
            env_password = os.environ.get(env_var)
            if env_password == password:
                return True
    return False

def get_role_from_password(password):
    for role in OWNER_ROLES:
        env_var = PASSWORD_ENV_VARS.get(role)
        if env_var:
            env_password = os.environ.get(env_var)
            if env_password == password:
                return role
    return None

def read_blocks(blockchain_file_path):
    blockchain_file = Path(blockchain_file_path)
    if not blockchain_file.exists():
        return
    with open(blockchain_file, "rb") as f:
        while True:
            header_bytes = f.read(block_helper.BLOCK_HEADER_SIZE)
            if not header_bytes:
                break
            try:
                data_len = struct.unpack_from("I", header_bytes, block_helper.BLOCK_HEADER_SIZE - 4)[0]
                data_bytes = f.read(data_len)
                yield header_bytes + data_bytes
            except struct.error:
                sys.exit(1)

def get_last_block_hash(blockchain_file_path):
    last_block = None
    for block_bytes in read_blocks(blockchain_file_path):
        last_block = block_bytes
    if last_block is None:
        return b'\0' * 32
    return hashlib.sha256(last_block).digest()

def get_item_state(blockchain_file_path, item_id_int):
    current_state = None
    case_id = None

    item_id_bytes = item_id_int.to_bytes(4, 'big')
    encrypted_item = block_helper.encrypt_data(item_id_bytes)
    target_hex_id = encrypted_item.hex().encode('utf-8')

    for block_bytes in read_blocks(blockchain_file_path):
        header_bytes = block_bytes[:block_helper.BLOCK_HEADER_SIZE]
        try:
            enc_item_id = struct.unpack_from("32s", header_bytes, 0x48)[0]

            if enc_item_id == target_hex_id:
                state_bytes = struct.unpack_from("12s", header_bytes, 0x68)[0]
                current_state = state_bytes.decode('utf-8').rstrip('\0')

                enc_case_id = struct.unpack_from("32s", header_bytes, 0x28)[0]
                try:
                    enc_bytes = bytes.fromhex(enc_case_id.decode('utf-8'))
                    dec_case = block_helper.decrypt_data(enc_bytes)
                    case_id = str(uuid.UUID(bytes=dec_case))
                except:
                    pass
        except (struct.error, ValueError):
            pass
    return current_state, case_id

def get_creator_for_item(blockchain_file_path, item_id_int):
    creator = ""
    for block_bytes in read_blocks(blockchain_file_path):
        block = block_helper.unpack_block(block_bytes)
        if block["state"] == "INITIAL":
            continue
        if block["item_id"] == item_id_int:
            creator = block["creator"]
            break
    return creator

def get_last_owner_for_item(blockchain_file_path, item_id_int):
    owner = ""
    for block_bytes in read_blocks(blockchain_file_path):
        block = block_helper.unpack_block(block_bytes)
        if block["state"] == "INITIAL":
            continue
        if block["item_id"] == item_id_int:
            owner = block["owner"]
    return owner

def create_genesis_block():
    prev_hash = b'\0' * 32
    timestamp = time.time()
    enc_case_id = b'0' * 32
    enc_item_id = b'0' * 32
    state_bytes = b"INITIAL\0\0\0\0\0"
    creator_bytes = b'\0' * 12
    owner_bytes = b'\0' * 12
    data_len = 14
    data = b"Initial block\0"
    
    header = struct.pack(
        block_helper.BLOCK_HEADER_FORMAT,
        prev_hash, timestamp, enc_case_id, enc_item_id,
        state_bytes, creator_bytes, owner_bytes, data_len
    )
    return header + data

def init_blockchain(blockchain_file_path):
    blockchain_file = Path(blockchain_file_path)
    if blockchain_file.exists():
        if blockchain_file.stat().st_size > 0:
            try:
                with open(blockchain_file, "rb") as f:
                    header = f.read(block_helper.BLOCK_HEADER_SIZE)
                    if len(header) == block_helper.BLOCK_HEADER_SIZE:
                        struct.unpack(block_helper.BLOCK_HEADER_FORMAT, header)
                        print("Blockchain file found with INITIAL block.")
                        return
            except Exception:
                pass
        sys.exit(1)

    genesis_block_bytes = create_genesis_block()
    try:
        with open(blockchain_file, "wb") as f:
            f.write(genesis_block_bytes)
        print("Blockchain file not found. Created INITIAL block.")
    except Exception:
        sys.exit(1)

def add_block(blockchain_file_path, case_id, item_ids_list, creator, password):
    if not check_password(password, roles=['creator']):
        print("Invalid password")
        sys.exit(1)
        
    blockchain_file = Path(blockchain_file_path)
    if not blockchain_file.exists():
        init_blockchain(blockchain_file_path)
    
    flat_ids = []
    if item_ids_list:
        for item in item_ids_list:
            if isinstance(item, list):
                flat_ids.extend(item)
            else:
                flat_ids.append(item)

    for item_id_str in flat_ids:
        try:
            item_id_int = int(item_id_str)
        except ValueError:
            sys.exit(1)

        state, _ = get_item_state(blockchain_file_path, item_id_int)
        if state is not None:
            print(f"Error: Item {item_id_int} already exists in the blockchain.", file=sys.stderr)
            sys.exit(1)

    for item_id_str in flat_ids:
        item_id_int = int(item_id_str)
        prev_hash = get_last_block_hash(blockchain_file_path)
        timestamp = time.time()
        
        new_block_bytes = block_helper.pack_block(
            prev_hash=prev_hash, timestamp=timestamp,
            case_id_str=case_id, item_id_int=item_id_int,
            state="CHECKEDIN", creator=creator, owner="", data=b""
        )
        
        try:
            with open(blockchain_file, "ab") as f:
                f.write(new_block_bytes)
            ts = datetime.fromtimestamp(timestamp, timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")
            print(f"Added item: {item_id_int}")
            print("Status: CHECKEDIN")
            print(f"Time of action: {ts}")
        except Exception:
            sys.exit(1)

def change_item_state(blockchain_file_path, item_id_str, password, new_state):
    if not check_password(password, roles=OWNER_ROLES):
        print("Invalid password")
        sys.exit(1)
    try:
        item_id_int = int(item_id_str)
    except ValueError:
        sys.exit(1)
        
    current_state, case_id = get_item_state(blockchain_file_path, item_id_int)
    if current_state is None:
        print(f"Error: Item {item_id_int} not found in blockchain.", file=sys.stderr)
        sys.exit(1)
        
    expected_state = "CHECKEDIN" if new_state == "CHECKEDOUT" else "CHECKEDOUT"
    if current_state != expected_state:
        print(f"Error: Cannot {new_state.lower().replace('checked', 'check')} item. Item is already {current_state.upper()}.", file=sys.stderr)
        sys.exit(1)
    
    blockchain_file = Path(blockchain_file_path)
    prev_hash = get_last_block_hash(blockchain_file_path)
    timestamp = time.time()
    creator = get_creator_for_item(blockchain_file_path, item_id_int)
    role = get_role_from_password(password)
    owner = role.upper() if role else ""
    new_block_bytes = block_helper.pack_block(
        prev_hash=prev_hash, timestamp=timestamp, case_id_str=case_id,
        item_id_int=item_id_int, state=new_state,
        creator=creator, owner=owner, data=b""
    )
    
    try:
        with open(blockchain_file, "ab") as f:
            f.write(new_block_bytes)
        ts = datetime.fromtimestamp(timestamp, timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")
        print(f"Case: {case_id}")
        if new_state == "CHECKEDIN":
            print(f"Checked in item: {item_id_int}")
        else:
            print(f"Checked out item: {item_id_int}")
        print(f"Status: {new_state}")
        print(f"Time of action: {ts}")
    except Exception:
        sys.exit(1)

