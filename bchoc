def check_password(password, roles):
    for role in roles:
        env_var = PASSWORD_ENV_VARS.get(role)
        if env_var:
            env_password = os.environ.get(env_var)
            if env_password == password:
                return True
    return False

def get_role_from_password(password):
    for role in OWNER_ROLES:
        env_var = PASSWORD_ENV_VARS.get(role)
        if env_var:
            env_password = os.environ.get(env_var)
            if env_password == password:
                return role
    return None


# Generative AI Used: ChatGPT (OpenAI, November 17, 2025)
# Purpose: We asked for a skeleton function to iterate through all blocks and
#          compute the last block’s SHA-256 hash to use as prev_hash for new blocks,
#          then we adjusted details (like handling the empty-chain case) ourselves.
# Prompt: "In my CSE 469 bchoc blockchain project, write a Python helper
#          get_last_block_hash(path) that reads all binary blocks and returns
#          the SHA-256 of the last block, or 32 zero bytes if there are no blocks."
def read_blocks(blockchain_file_path):
    blockchain_file = Path(blockchain_file_path)
    if not blockchain_file.exists():
        return
    with open(blockchain_file, "rb") as f:
        while True:
            header_bytes = f.read(block_helper.BLOCK_HEADER_SIZE)
            if not header_bytes:
                break
            try:
                data_len = struct.unpack_from("I", header_bytes, block_helper.BLOCK_HEADER_SIZE - 4)[0]
                data_bytes = f.read(data_len)
                yield header_bytes + data_bytes
            except struct.error:
                sys.exit(1)

def get_last_block_hash(blockchain_file_path):
    last_block = None
    for block_bytes in read_blocks(blockchain_file_path):
        last_block = block_bytes
    if last_block is None:
        return b'\0' * 32
    return hashlib.sha256(last_block).digest()


# Generative AI Used: ChatGPT (OpenAI, November 18, 2025)
# Purpose: We requested a skeleton and guidance for efficiently computing the current
#          state of an item by scanning encrypted item IDs directly from the header,
#          instead of fully unpacking every block. We then integrated offsets and
#          small fixes to match the project’s binary layout.
# Prompt: "Given my block_helper header format, help me write a get_item_state(...)
#          in Python that encrypts an integer item_id, scans all blocks, compares
#          the encrypted item_id field, and returns the item’s latest state and case_id."
def get_item_state(blockchain_file_path, item_id_int):
    current_state = None
    case_id = None

    item_id_bytes = item_id_int.to_bytes(4, 'big')
    encrypted_item = block_helper.encrypt_data(item_id_bytes)
    target_hex_id = encrypted_item.hex().encode('utf-8')

    for block_bytes in read_blocks(blockchain_file_path):
        header_bytes = block_bytes[:block_helper.BLOCK_HEADER_SIZE]
        try:
            enc_item_id = struct.unpack_from("32s", header_bytes, 0x48)[0]

            if enc_item_id == target_hex_id:
                state_bytes = struct.unpack_from("12s", header_bytes, 0x68)[0]
                current_state = state_bytes.decode('utf-8').rstrip('\0')

                enc_case_id = struct.unpack_from("32s", header_bytes, 0x28)[0]
                try:
                    enc_bytes = bytes.fromhex(enc_case_id.decode('utf-8'))
                    dec_case = block_helper.decrypt_data(enc_bytes)
                    case_id = str(uuid.UUID(bytes=dec_case))
                except:
                    pass
        except (struct.error, ValueError):
            pass
    return current_state, case_id

def get_creator_for_item(blockchain_file_path, item_id_int):
    creator = ""
    for block_bytes in read_blocks(blockchain_file_path):
        block = block_helper.unpack_block(block_bytes)
        if block["state"] == "INITIAL":
            continue
        if block["item_id"] == item_id_int:
            creator = block["creator"]
            break
    return creator

def get_last_owner_for_item(blockchain_file_path, item_id_int):
    owner = ""
    for block_bytes in read_blocks(blockchain_file_path):
        block = block_helper.unpack_block(block_bytes)
        if block["state"] == "INITIAL":
            continue
        if block["item_id"] == item_id_int:
            owner = block["owner"]
    return owner

def create_genesis_block():
    prev_hash = b'\0' * 32
    timestamp = time.time()
    enc_case_id = b'0' * 32
    enc_item_id = b'0' * 32
    state_bytes = b"INITIAL\0\0\0\0\0"
    creator_bytes = b'\0' * 12
    owner_bytes = b'\0' * 12
    data_len = 14
    data = b"Initial block\0"
    
    header = struct.pack(
        block_helper.BLOCK_HEADER_FORMAT,
        prev_hash, timestamp, enc_case_id, enc_item_id,
        state_bytes, creator_bytes, owner_bytes, data_len
    )
    return header + data

def init_blockchain(blockchain_file_path):
    blockchain_file = Path(blockchain_file_path)
    if blockchain_file.exists():
        if blockchain_file.stat().st_size > 0:
            try:
                with open(blockchain_file, "rb") as f:
                    header = f.read(block_helper.BLOCK_HEADER_SIZE)
                    if len(header) == block_helper.BLOCK_HEADER_SIZE:
                        struct.unpack(block_helper.BLOCK_HEADER_FORMAT, header)
                        print("Blockchain file found with INITIAL block.")
                        return
            except Exception:
                pass
        sys.exit(1)

    genesis_block_bytes = create_genesis_block()
    try:
        with open(blockchain_file, "wb") as f:
            f.write(genesis_block_bytes)
        print("Blockchain file not found. Created INITIAL block.")
    except Exception:
        sys.exit(1)

def add_block(blockchain_file_path, case_id, item_ids_list, creator, password):
    if not check_password(password, roles=['creator']):
        print("Invalid password")
        sys.exit(1)
        
    blockchain_file = Path(blockchain_file_path)
    if not blockchain_file.exists():
        init_blockchain(blockchain_file_path)
    
    flat_ids = []
    if item_ids_list:
        for item in item_ids_list:
            if isinstance(item, list):
                flat_ids.extend(item)
            else:
                flat_ids.append(item)

    for item_id_str in flat_ids:
        try:
            item_id_int = int(item_id_str)
        except ValueError:
            sys.exit(1)

        state, _ = get_item_state(blockchain_file_path, item_id_int)
        if state is not None:
            print(f"Error: Item {item_id_int} already exists in the blockchain.", file=sys.stderr)
            sys.exit(1)

    for item_id_str in flat_ids:
        item_id_int = int(item_id_str)
        prev_hash = get_last_block_hash(blockchain_file_path)
        timestamp = time.time()
        
        new_block_bytes = block_helper.pack_block(
            prev_hash=prev_hash, timestamp=timestamp,
            case_id_str=case_id, item_id_int=item_id_int,
            state="CHECKEDIN", creator=creator, owner="", data=b""
        )
        
        try:
            with open(blockchain_file, "ab") as f:
                f.write(new_block_bytes)
            ts = datetime.fromtimestamp(timestamp, timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")
            print(f"Added item: {item_id_int}")
            print("Status: CHECKEDIN")
            print(f"Time of action: {ts}")
        except Exception:
            sys.exit(1)

def change_item_state(blockchain_file_path, item_id_str, password, new_state):
    if not check_password(password, roles=OWNER_ROLES):
        print("Invalid password")
        sys.exit(1)
    try:
        item_id_int = int(item_id_str)
    except ValueError:
        sys.exit(1)
        
    current_state, case_id = get_item_state(blockchain_file_path, item_id_int)
    if current_state is None:
        print(f"Error: Item {item_id_int} not found in blockchain.", file=sys.stderr)
        sys.exit(1)
        
    expected_state = "CHECKEDIN" if new_state == "CHECKEDOUT" else "CHECKEDOUT"
    if current_state != expected_state:
        print(f"Error: Cannot {new_state.lower().replace('checked', 'check')} item. Item is already {current_state.upper()}.", file=sys.stderr)
        sys.exit(1)
    
    blockchain_file = Path(blockchain_file_path)
    prev_hash = get_last_block_hash(blockchain_file_path)
    timestamp = time.time()
    creator = get_creator_for_item(blockchain_file_path, item_id_int)
    role = get_role_from_password(password)
    owner = role.upper() if role else ""
    new_block_bytes = block_helper.pack_block(
        prev_hash=prev_hash, timestamp=timestamp, case_id_str=case_id,
        item_id_int=item_id_int, state=new_state,
        creator=creator, owner=owner, data=b""
    )
    
    try:
        with open(blockchain_file, "ab") as f:
            f.write(new_block_bytes)
        ts = datetime.fromtimestamp(timestamp, timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")
        print(f"Case: {case_id}")
        if new_state == "CHECKEDIN":
            print(f"Checked in item: {item_id_int}")
        else:
            print(f"Checked out item: {item_id_int}")
        print(f"Status: {new_state}")
        print(f"Time of action: {ts}")
    except Exception:
        sys.exit(1)

def remove_item(blockchain_file_path, item_id_str, reason, owner_info, password):
    if not check_password(password, roles=['creator']):
        print("Invalid password")
        sys.exit(1)
        
    if reason not in REMOVAL_REASONS:
        print("Error: Invalid reason.", file=sys.stderr)
        sys.exit(1)
    
    if reason == "RELEASED" and not owner_info:
        owner_info = ""
        
    data_bytes = b""
    if reason == "RELEASED":
        data_bytes = owner_info.encode('utf-8')

    try:
        item_id_int = int(item_id_str)
    except ValueError:
        sys.exit(1)

    current_state, case_id = get_item_state(blockchain_file_path, item_id_int)
    if current_state is None:
        print("Error: Item not found.", file=sys.stderr)
        sys.exit(1)
    if current_state != "CHECKEDIN":
        print(f"Error: Cannot remove item. Item must be CHECKEDIN (current state: {current_state}).", file=sys.stderr)
        sys.exit(1)
        
    blockchain_file = Path(blockchain_file_path)
    prev_hash = get_last_block_hash(blockchain_file_path)
    timestamp = time.time()
    creator = get_creator_for_item(blockchain_file_path, item_id_int)
    owner = get_last_owner_for_item(blockchain_file_path, item_id_int)
    new_block_bytes = block_helper.pack_block(
        prev_hash=prev_hash, timestamp=timestamp, case_id_str=case_id,
        item_id_int=item_id_int, 
        state=reason,
        creator=creator, 
        owner=owner,
        data=data_bytes
    )
    
    try:
        with open(blockchain_file, "ab") as f:
            f.write(new_block_bytes)
        ts = datetime.fromtimestamp(timestamp, timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")
        print(f"Case: {case_id}")
        print(f"Removed item: {item_id_int}")
        print(f"Status: {reason}")
        print(f"Time of action: {ts}")
    except Exception:
        sys.exit(1)

def show_cases(blockchain_file_path, password):
    if password and not check_password(password, roles=OWNER_ROLES):
        print("Invalid password")
        sys.exit(1)
        
    cases = set()
    for block_bytes in read_blocks(blockchain_file_path):
        if len(block_bytes) < block_helper.BLOCK_HEADER_SIZE:
            continue
        block = block_helper.unpack_block(block_bytes)
        if block['state'] != "INITIAL":
            cases.add(block['case_id'])
    for case in sorted(list(cases)):
        print(case)

def show_items(blockchain_file_path, case_id, password):
    if password and not check_password(password, roles=OWNER_ROLES):
        print("Invalid password")
        sys.exit(1)
    items = set()
    for block_bytes in read_blocks(blockchain_file_path):
        block = block_helper.unpack_block(block_bytes)
        if block['state'] != 'INITIAL' and block['case_id'] == case_id:
            items.add(block['item_id'])
    for item in sorted(list(items)):
        print(item)


# Generative AI Used: ChatGPT (OpenAI, November 19, 2025)
# Purpose: We asked for a skeleton for the show history feature that supports
#          filtering by case_id and/or item_id, optional -n limiting, and -r
#          reverse ordering, matching the autograder’s expectations. We then
#          refined the printing format and integrated it with our timestamp logic.
# Prompt: "For my CSE 469 bchoc tool, write a Python show_history function that
#          reads all blocks, optionally filters by case ID and item ID, supports
#          -n for the number of entries and -r to reverse the order, and prints
#          the case, item, state, and ISO 8601 time for each record."
def show_history(blockchain_file_path, case_id, item_id, num_entries, reverse, password):
    if not password or not check_password(password, roles=OWNER_ROLES):
        print("Invalid password")
        sys.exit(1)

    history = []

    target_item_id = None
    if item_id:
        try:
            target_item_id = int(item_id)
        except ValueError:
            sys.exit(1)

    for block_bytes in read_blocks(blockchain_file_path):
        block = block_helper.unpack_block(block_bytes)
        if target_item_id is not None and block['item_id'] != target_item_id:
            continue
        if case_id and block['case_id'] != case_id:
            continue
        history.append(block)

    if reverse:
        history.reverse()

    if num_entries:
        history = history[:num_entries]

    for block in history:
        ts = datetime.fromtimestamp(block["timestamp"], timezone.utc)
        iso_time = ts.isoformat(timespec="microseconds").replace("+00:00", "Z")
        print(f"Case: {block['case_id']}")
        print(f"Item: {block['item_id']}")
        print(f"Action: {block['state']}")
        print(f"Time: {iso_time}")
        print("")


# Generative AI Used: ChatGPT (OpenAI, November 19, 2025)
# Purpose: We asked for help designing the verification skeleton that walks the
#          chain, checks parent hashes, and enforces valid state transitions for
#          each item. We then tuned the exact error messages and integrated the
#          specific rules for CHECKEDIN/CHECKEDOUT/REMOVAL required by the spec.
# Prompt: "Write a verify_blockchain(path) function for my bchoc project that
#          iterates through each block, verifies prev_hash matches the SHA-256
#          of the previous block, tracks per-item states, and reports ERROR with
#          the bad block hash if any invalid transition occurs."
def verify_blockchain(blockchain_file_path):
    expected_prev_hash = b'\0' * 32
    num_transactions = 0
    is_clean = True
    
    item_states = {}
    
    try:
        for block_bytes in read_blocks(blockchain_file_path):
            num_transactions += 1
            header_bytes = block_bytes[:block_helper.BLOCK_HEADER_SIZE]
            prev_hash = struct.unpack_from("32s", header_bytes, 0x00)[0]
            
            if prev_hash != expected_prev_hash:
                print(f"Transactions in blockchain: {num_transactions}")
                print("State of blockchain: ERROR")
                print(f"Bad block: {hashlib.sha256(block_bytes).hexdigest()}")
                print("Parent block hash did not match expected hash.")
                is_clean = False
                sys.exit(1)
            
            expected_prev_hash = hashlib.sha256(block_bytes).digest()
            
            block = block_helper.unpack_block(block_bytes)
            state = block['state']
            item_id = block['item_id']
            
            if state == "INITIAL":
                continue

            if item_id not in item_states:
                if state != "CHECKEDIN":
                    print(f"Transactions in blockchain: {num_transactions}")
                    print("State of blockchain: ERROR")
                    print(f"Bad block: {hashlib.sha256(block_bytes).hexdigest()}")
                    print("Item checked out or checked in after removal from chain.")
                    is_clean = False
                    sys.exit(1)
                item_states[item_id] = "CHECKEDIN"
            else:
                current = item_states[item_id]
                valid = True
                if state == "CHECKEDIN" and current != "CHECKEDOUT":
                    valid = False
                elif state == "CHECKEDOUT" and current != "CHECKEDIN":
                    valid = False
                elif state in REMOVAL_REASONS and current != "CHECKEDIN":
                    valid = False
                
                if not valid:
                    print(f"Transactions in blockchain: {num_transactions}")
                    print("State of blockchain: ERROR")
                    print(f"Bad block: {hashlib.sha256(block_bytes).hexdigest()}")
                    print("Item checked out or checked in after removal from chain.")
                    sys.exit(1)
                
                item_states[item_id] = state

    except Exception:
        print(f"Transactions in blockchain: {num_transactions}")
        print("State of blockchain: ERROR")
        sys.exit(1)

    if is_clean:
        print(f"Transactions in blockchain: {num_transactions}")
        print("State of blockchain: CLEAN")


# Generative AI Used: ChatGPT (OpenAI, November 20, 2025)
# Purpose: We asked for a skeleton summary function to count per-state totals
#          (CHECKEDIN, CHECKEDOUT, DISPOSED, etc.) for a given case_id using
#          collections.defaultdict. We then wired it into our exact output format.
# Prompt: "Help me write a summary(case_id) function for my bchoc project that
#          scans all blocks, filters by case ID, tallies how many items end up
#          in each state, and prints a small text report for the case."
def show_summary(blockchain_file_path, case_id, password):
    if password is not None and not check_password(password, roles=OWNER_ROLES):
        print("Invalid password", file=sys.stderr)
        sys.exit(1)

    item_ids = set()
    state_counts = defaultdict(int)
    for block_bytes in read_blocks(blockchain_file_path):
        block = block_helper.unpack_block(block_bytes)
        if block['state'] != 'INITIAL' and block['case_id'] == case_id:
            item_ids.add(block['item_id'])
            state_counts[block['state']] += 1
        
    print(f"Case Summary for Case ID: {case_id}")
    print(f"Total Evidence Items: {len(item_ids)}")
    print(f"Checked In: {state_counts['CHECKEDIN']}")
    print(f"Checked Out: {state_counts['CHECKEDOUT']}")
    print(f"Disposed: {state_counts['DISPOSED']}")
    print(f"Destroyed: {state_counts['DESTROYED']}")
    print(f"Released: {state_counts['RELEASED']}")


# Generative AI Used: ChatGPT (OpenAI, November 20, 2025)
# Purpose: We asked for an argparse *skeleton* with subcommands (init, add,
#          checkout, checkin, remove, show, verify, summary) and then we
#          customized argument names, required flags, and the dispatch logic
#          ourselves to match the project specification exactly.
# Prompt: "Provide a Python argparse skeleton for a CLI tool called bchoc with
#          subcommands init, add, checkout, checkin, remove, show (cases/items/
#          history), verify, and summary, and show how to dispatch to functions
#          for each command."
def main():
    blockchain_file = os.environ.get(BCHOC_FILE_PATH_ENV, DEFAULT_BLOCKCHAIN_FILE)

    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    
    parser_init = subparsers.add_parser("init")
    
    parser_add = subparsers.add_parser("add")
    parser_add.add_argument("-c", required=True, dest="case_id")
    parser_add.add_argument("-i", required=True, dest="item_ids", action='append')
    parser_add.add_argument("-g", required=True, dest="creator")
    parser_add.add_argument("-p", required=True, dest="password")

    parser_checkout = subparsers.add_parser("checkout")
    parser_checkout.add_argument("-i", required=True, dest="item_id")
    parser_checkout.add_argument("-p", required=True, dest="password")
    
    parser_checkin = subparsers.add_parser("checkin")
    parser_checkin.add_argument("-i", required=True, dest="item_id")
    parser_checkin.add_argument("-p", required=True, dest="password")

    parser_remove = subparsers.add_parser("remove")
    parser_remove.add_argument("-i", required=True, dest="item_id")
    parser_remove.add_argument("-y", "--why", required=True, dest="reason")
    parser_remove.add_argument("-o", dest="owner")
    parser_remove.add_argument("-p", required=True, dest="password")

    parser_show = subparsers.add_parser("show")
    parser_show.add_argument("show_target", choices=['cases', 'items', 'history'])
    parser_show.add_argument("-p", required=False, dest="password")
    parser_show.add_argument("-c", dest="case_id")
    parser_show.add_argument("-i", dest="item_id")
    parser_show.add_argument("-n", dest="num_entries", type=int)
    parser_show.add_argument("-r", "--reverse", dest="reverse", action='store_true')

    parser_verify = subparsers.add_parser("verify")
    
    parser_summary = subparsers.add_parser("summary")
    parser_summary.add_argument("-c", required=True, dest="case_id")
    parser_summary.add_argument("-p", required=False, dest="password")

    try:
        args = parser.parse_args()
    except:
        sys.exit(1) 

    if args.command == "init":
        init_blockchain(blockchain_file)
    elif args.command == "add":
        add_block(blockchain_file, args.case_id, args.item_ids, args.creator, args.password)
    elif args.command == "checkout":
        change_item_state(blockchain_file, args.item_id, args.password, "CHECKEDOUT")
    elif args.command == "checkin":
        change_item_state(blockchain_file, args.item_id, args.password, "CHECKEDIN")
    elif args.command == "remove":
        remove_item(blockchain_file, args.item_id, args.reason.upper(), args.owner, args.password)
    elif args.command == "show":
        if args.show_target == "cases":
            show_cases(blockchain_file, args.password)
        elif args.show_target == "items":
            if not args.case_id:
                sys.exit(1)
            show_items(blockchain_file, args.case_id, args.password)
        elif args.show_target == "history":
            show_history(blockchain_file, args.case_id, args.item_id, args.num_entries, args.reverse, args.password)
    elif args.command == "verify":
        verify_blockchain(blockchain_file)
    elif args.command == "summary":
        show_summary(blockchain_file, args.case_id, args.password)
    else:
        sys.exit(1)

if __name__ == "__main__":
    main()
